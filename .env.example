# Copy this file to .env.local (for `npm run dev`) and fill in the values.
# On Cloudflare, add the same names under Workers & Pages → vectogo-web →
# Settings → Variables and Secrets. Never commit real keys.

# The site's own address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use the test-mode key until launch)
STRIPE_SECRET_KEY=sk_test_...
# Stripe → Developers → Webhooks (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend → API Keys. Leave empty and emails are printed to the terminal instead.
RESEND_API_KEY=
EMAIL_FROM=Vectogo <hello@vectogo.com>

# Who can open /admin (comma-separated emails)
ADMIN_EMAILS=you@example.com
